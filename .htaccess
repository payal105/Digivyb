# ---- Digivyb: Apache / LiteSpeed (Hostinger) ----
DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Generated robots/sitemap (public names only; the .php files themselves stay hidden below)
  RewriteRule ^robots\.txt$ robots.php [END]
  RewriteRule ^sitemap\.xml$ sitemap.php [END]

  # Never serve dotfiles (.git, .env ...), internal code, dev files or archives.
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
  RewriteRule ^(includes|FinalLOgoFiles)(/|$) - [R=404,L]
  RewriteRule ^(router\.php|robots\.php|sitemap\.php)$ - [R=404,L]
  RewriteRule \.(zip|md|json|lock|log|sql|bak|env|ai|eps|tif)$ - [R=404,L]

  # Strip .php from public URLs: /about.php -> /about
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # Serve /about from about.php, /services/web-and-apps from services/web-and-apps.php
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

ErrorDocument 404 /404.php

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---- Compression & caching ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  # CSS/JS are cache-busted with ?v=<mtime>, so they can be cached long.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
